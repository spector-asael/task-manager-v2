<div class="header">
    <h1> Welcome to the Task Manager! </h1>

    <div>
        <div>
            <% if (tasks.length > 0) { %>
                <% tasks.forEach(task => { %>
                    <div class="task-bar <%= task.completion_status ? 'complete-task' : 'incomplete-task' %>">
                        <div>
                            <p>Task ID: <%= task.task_id %></p>
                            <p>Task name: <%= task.task_name %></p>
                            <p>Task description: 
                                <% if (task.task_description) { %>
                                    <%= task.task_description %>
                                <% } else { %>
                                    None
                                <% } %>
                            </p>
                            <p>
                                Task Priority:
                                <%= task.priority_name%>
                            </p>
                        </div>
                        <div class="task-button">
                            <% if (!task.completion_status) { %>
                                <button class="complete" task-id="<%= task.task_id %>"> Complete Task </button>
                            <% } else { %>
                                <button class="undo" task-id="<%= task.task_id %>"> Undo Completion </button>
                            <% } %>
                            <button class="delete" task-id="<%= task.task_id %>"> Delete Task </button>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="no">No tasks available</p>
            <% } %>
        </div>
    </div>

<script type="module" src="./script.js"></script>
