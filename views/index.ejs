<div class="header">
    <h1> Welcome to the Task Manager! </h1>
    
<div >
    <div >
        <% if (tasks.length > 0) { %>
            <% tasks.forEach(task => { %>
                <% if (task.complete != 1) { %>
                    <div  <%= task.complete ? 'completed' : 'incomplete' %>">
                        <div >
                            <p>Task ID: <%= task.id %></p>
                            <p>Task name: <%= task.task_name %></p>
                            <p>Task description: 
                                <% if (task.task_description) { %>
                                    <%= task.task_description %>
                                <% } else { %>
                                    None
                                <% } %>
                            </p>
                            <p>
                                Task Priority:
                                <%= task.priority_name%>
                            </p>
                        </div>
                        <div class="task-button">
                            <% if (!task.complete) { %>
                                <!-- 
                                <form method="POST" action="/complete-task/<%= task.id %>" >
                                    <button type="submit" class="complete">Complete Task</button>
                                </form>
                                <br> -->
                                <button class="complete" task-id="<%= task.id %>"> Complete Task </button>
                            <% } else { %>
                                <!--
                                <form method="POST" action="/complete-task/<%= task.id %>" >
                                    <button type="submit" class="undo">Undo Completion</button>
                                </form> 
                                <br> -->
                                <button class="undo" task-id="<%= task.id %>"> Undo Completion </button>
                            <% } %>
                            <!--
                            <form method="POST" action="/delete-task/<%= task.id %>">
                                <button type="submit" class="delete">Delete Task</button>
                            </form>
                            -->
                                <button class="delete" task-id="<%= task.id %>"> Delete Task </button>
                        </div>
                    </div>
                <% } %>
            <% }) %>
        <% } else { %>
            <p class="no">No tasks available</p>
        <% } %>
    </div>
</div>
<script src="./script.js"></script>