
<h3> Filter by Priority </h2>
<div class="filter-group priority-filter">
    <button data-priority="1">Low Priority</button>
    <button data-priority="2">Medium Priority</button>
    <button data-priority="3">High Priority</button>
  </div>
  
  <div class="separator"></div>

  <h3> Filter by Completion Status </h2>
  <div class="filter-group status-filter">
    <button data-status="0">Incomplete Tasks</button>
    <button data-status="1">Completed Tasks</button>
  </div>

  <div class="separator"></div>

  <div class="filter-group" id="reset-filter">
    <button id="reset"> Reset Filters </button>
  </div>
  